# DATABASE CONFIGURATION
DB_HOST=localhost
DB_NAME=quest_ojt_db
DB_USER=root
DB_PASS=

# APPLICATION SETTINGS
APP_NAME="Quest Hotel OJT Portal"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# TIMEZONE
APP_TIMEZONE=Asia/Manila

# SECURITY (you can expand this later)
SESSION_LIFETIME=120

# SMTP (Email) - Required for real password reset emails
# SECURITY NOTICE: Never use your real Gmail account password!
# For Gmail, create and use a Google "App Password" (requires 2FA enabled on Google account):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@example.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME="Quest OJT System"
